{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradebotzi-app",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "EngineDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EngineDO"] }],
  "triggers": { "crons": ["* * * * *"] },
  "alias": {
    "node:fs": "./cloudflare/shims/fs.mjs",
    "node:child_process": "./cloudflare/shims/child_process.mjs"
  },
  "observability": { "enabled": true }
}
