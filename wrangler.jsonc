{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tradebotzi-app",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LEGACY_API_ORIGIN": "https://compromise-swap-grove-indianapolis.trycloudflare.com"
  },
  "observability": {
    "enabled": true
  }
}
