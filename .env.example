# ============================================================
# Zbot Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
# ============================================================

# Application
NODE_ENV=development
PORT=3000
API_PORT=3001

# Database
DATABASE_URL=postgresql://zbot:zbot@localhost:5432/zbot

# ============================================================
# MARKET DATA PROVIDERS
# ============================================================
# Binance: No API key required for public data
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Coinbase: No API key required for public spot data
# COINBASE_API_KEY=
# COINBASE_API_SECRET=

# Hyperliquid: No API key required for public data
# HYPERLIQUID_WALLET=

# Alpaca (optional - free tier requires account):
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Twelve Data (optional - free tier requires account):
# TWELVEDATA_API_KEY=

# ============================================================
# AI PROVIDERS
# ============================================================
# Cloudflare Workers AI (free tier):
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# OpenAI-compatible endpoint (e.g., Groq, Together):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama:
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# APPLICATION SETTINGS
# ============================================================
# Paper-only mode (MUST be true - no live trading)
PAPER_ONLY=true

# Evaluation frequency (ms)
EVALUATION_FREQUENCY_MS=3600000

# Ranking frequency (ms)
RANKING_FREQUENCY_MS=14400000

# ============================================================
# SECURITY
# ============================================================
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Rate limiting (requests per minute)
RATE_LIMIT_RPM=60
